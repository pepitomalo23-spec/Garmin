    <iq:application id="3eff0890a4d04d9293870043ae2b2cff" type="watch-app" name="@Strings.AppName" entry="CronoApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="fenix6xpro"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Background"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>spa</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
